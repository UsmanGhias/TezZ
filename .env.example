# ─────────────────────────────────────────────────────────────────────────────
# TezZ Marketplace — environment template
# Copy to `.env` and edit. Never commit `.env` itself.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo_password
POSTGRES_DB=teez_marketplace

# ── Odoo ─────────────────────────────────────────────────────────────────────
# Master password (admin) for the Odoo database manager.
ODOO_ADMIN_PASSWORD=admin_master_password_change_me

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ── pgAdmin (optional dev UI) ────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@tezz.local
PGADMIN_DEFAULT_PASSWORD=admin

# ── tezz_api JWT ─────────────────────────────────────────────────────────────
# These can also be set via Odoo system parameters at runtime, but seeding
# them via env makes redeploys deterministic.
TEZZ_JWT_SECRET=change-me-to-a-long-random-string
TEZZ_JWT_ISSUER=tezz-api
TEZZ_ACCESS_TTL=1800
TEZZ_REFRESH_TTL=2592000

# ── Payment gateways (server-side keys; never expose to the mobile app) ──────
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Firebase Cloud Messaging (server) ────────────────────────────────────────
FCM_SERVICE_ACCOUNT_JSON_PATH=/run/secrets/fcm-sa.json

# ── Flutter (consumed at build time via --dart-define) ───────────────────────
# Example:
#   flutter run --dart-define=API_BASE_URL=$API_BASE_URL
API_BASE_URL=http://192.168.1.5:8069
JAZZCASH_PUBLIC_MERCHANT_ID=
EASYPAISA_PUBLIC_STORE_ID=
GOOGLE_MAPS_API_KEY=
