<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_category_tezz" model="ir.module.category">
            <field name="name">TezZ Marketplace</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_tezz_customer" model="res.groups">
            <field name="name">TezZ Customer (API)</field>
            <field name="category_id" ref="module_category_tezz"/>
            <field name="comment">Default role assigned to mobile-app customers.</field>
        </record>

        <record id="group_tezz_vendor" model="res.groups">
            <field name="name">TezZ Vendor (API)</field>
            <field name="category_id" ref="module_category_tezz"/>
            <field name="implied_ids" eval="[(4, ref('group_tezz_customer'))]"/>
            <field name="comment">Marketplace seller — can manage own products / orders via the API.</field>
        </record>

        <record id="group_tezz_admin" model="res.groups">
            <field name="name">TezZ Admin (API)</field>
            <field name="category_id" ref="module_category_tezz"/>
            <field name="implied_ids" eval="[(4, ref('group_tezz_vendor'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
