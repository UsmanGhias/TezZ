<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_gc_refresh_tokens" model="ir.cron">
            <field name="name">TezZ API: GC expired refresh tokens</field>
            <field name="model_id" ref="model_tezz_refresh_token"/>
            <field name="state">code</field>
            <field name="code">model.gc()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

        <record id="cron_gc_otps" model="ir.cron">
            <field name="name">TezZ API: GC expired OTPs</field>
            <field name="model_id" ref="model_tezz_otp"/>
            <field name="state">code</field>
            <field name="code">model.gc()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
